/**
 * GET /api/admin/debug-auth?s=vndiag&email=xxx
 * Endpoint de diagnóstico — NÃO usa requireAdmin para diagnosticar por que falha.
 * Protegido apenas por query param secret. REMOVER após resolver o problema.
 */
import { NextRequest, NextResponse } from 'next/server'
import { auth } from '@/lib/auth'
import { prisma } from '@/lib/prisma'

export const dynamic = 'force-dynamic'

export async function GET(req: NextRequest) {
  const secret = req.nextUrl.searchParams.get('s')
  if (secret !== 'vndiag') {
    return NextResponse.json({ error: 'Access denied' }, { status: 403 })
  }

  // ── Teste 1: auth() sem request (como antes) ────────────────────────────────
  let sessionDirect = null
  let errorDirect: string | null = null
  try {
    sessionDirect = await auth()
  } catch (e) {
    errorDirect = String(e)
  }

  // ── Teste 2: auth(req) com request (fix proposto) ───────────────────────────
  let sessionWithReq = null
  let errorWithReq: string | null = null
  try {
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    sessionWithReq = await (auth as any)(req as Request)
  } catch (e) {
    errorWithReq = String(e)
  }

  const fmt = (s: typeof sessionDirect) => {
    if (!s) return null
    const u = s.user as { type?: string; role?: string; email?: string; id?: string } | null
    return { type: u?.type, role: u?.role, email: u?.email, id: u?.id }
  }

  // ── Dados do utilizador na DB (se email fornecido) ──────────────────────────
  const email = req.nextUrl.searchParams.get('email')
  let dbUser = null
  if (email) {
    try {
      const user = await prisma.user.findUnique({
        where: { email },
        select: {
          id: true, email: true, name: true, role: true,
          active: true, mustChangePassword: true, lastLoginAt: true, password: true,
        },
      })
      if (user) {
        dbUser = {
          ...user,
          hashType: user.password?.startsWith('$argon2id')
            ? 'argon2id'
            : user.password?.startsWith('$2b$') || user.password?.startsWith('$2a$')
            ? 'bcrypt'
            : 'unknown',
          hashPrefix: user.password?.substring(0, 20) + '…',
          password: undefined,
        }
      }
    } catch (e) {
      dbUser = { error: String(e) }
    }
  }

  return NextResponse.json({
    test1_direct_auth_call: {
      hasSession: !!sessionDirect,
      user: fmt(sessionDirect),
      wouldPassAdmin: (sessionDirect?.user as { type?: string })?.type === 'admin',
      error: errorDirect,
    },
    test2_auth_with_request: {
      hasSession: !!sessionWithReq,
      user: fmt(sessionWithReq),
      wouldPassAdmin: (sessionWithReq?.user as { type?: string })?.type === 'admin',
      error: errorWithReq,
    },
    env: {
      nodeEnv: process.env.NODE_ENV,
      hasPepper: !!process.env.PASSWORD_PEPPER,
      hasAuthSecret: !!(process.env.AUTH_SECRET || process.env.NEXTAUTH_SECRET),
    },
    dbUser,
  })
}
