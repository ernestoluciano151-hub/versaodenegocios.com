# Base de dados (Supabase ou PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# NextAuth / Auth.js
AUTH_SECRET="gerar-com-openssl-rand-base64-32"
NEXTAUTH_SECRET="gerar-com-openssl-rand-base64-32"   # alias — AUTH_SECRET tem precedência
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Segurança — Password Pepper (OBRIGATÓRIO em produção)
# Gerar com: openssl rand -base64 32
# NUNCA commitar este valor; armazenar apenas em variáveis de ambiente do servidor.
# O Pepper é aplicado via HMAC-SHA256 ANTES do hash Argon2id. Não é guardado na BD.
PASSWORD_PEPPER="gerar-com-openssl-rand-base64-32"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary (imagens)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (emails)
RESEND_API_KEY=""
EMAIL_FROM="noreply@vn-tech.ao"
ADMIN_EMAIL="admin@vn-tech.ao"

# Stripe (futuro)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Multicaixa Express — Stub (substituído por EMIS GPO abaixo)
MULTICAIXA_API_KEY=""
MULTICAIXA_API_SECRET=""
MULTICAIXA_ENDPOINT=""

# AppyPay / EasyPay (Banco BCS) — GPO Multicaixa Express (RESERVA — usado só
# se EMIS_FRAME_TOKEN, abaixo, não estiver configurado)
# Portal: https://easypay.bancobcs.ao
#   Client ID + Client Secret: Configurações → Credenciais
#   GPO Key: Aplicações → (aplicação GPO) → Programador → copiar chave
#   Webhook a configurar no portal: https://versaodenegocios.com/api/webhooks/emis (POST)
APPYPAY_CLIENT_ID=""
APPYPAY_CLIENT_SECRET=""
APPYPAY_GPO_KEY=""
# Pagamentos por Referência — chave da aplicação "Referência" no portal
APPYPAY_REF_KEY=""
# (opcional) nº de Entidade Multicaixa, fallback de exibição se a API não devolver
APPYPAY_REF_ENTITY=""
# Produção: bee57785-7a19-4f1c-9c8d-aa03f2f0e333 · Teste: 2aed7612-de64-46b5-9e59-1f48f8902d14
APPYPAY_RESOURCE="bee57785-7a19-4f1c-9c8d-aa03f2f0e333"
APPYPAY_AUTH_URL="https://login.microsoftonline.com/auth.appypay.co.ao/oauth2/token"
APPYPAY_API_BASE="https://gwy-api.appypay.co.ao/v2.0"

# EMIS GPO — conta oficial directa da VN Commerce (Comerciante nº 340472,
# POS nº 548377). Método PRINCIPAL do Multicaixa Express assim que
# EMIS_FRAME_TOKEN estiver preenchido — enquanto estiver vazio, o sistema
# usa a AppyPay/EasyPay (APPYPAY_*) como reserva, sem interromper pagamentos.
#
# Como obter o EMIS_FRAME_TOKEN:
#   1. Aceder a https://pagamentonline.emis.co.ao/online-payment-gateway/portal/
#      com as credenciais do comerciante (Configurações → Email tem o
#      contacto de acesso; a senha inicial foi enviada pela EMIS).
#   2. Clicar no ícone de utilizador (canto superior direito) → Perfil do Utilizador.
#   3. Copiar o "Frame token" apresentado.
EMIS_MERCHANT_ID="340472"
EMIS_FRAME_TOKEN=""
EMIS_GPO_PORTAL_URL="https://pagamentonline.emis.co.ao/online-payment-gateway/portal"
EMIS_CALLBACK_URL="https://versaodenegocios.com/api/webhooks/emis"
# (cssUrl testado e confirmado bloqueado pela CSP da própria EMIS — ver
# comentário em src/lib/payments/emis-gpo.ts. Não usamos este parâmetro.)
# OBRIGATÓRIO em produção — segredo partilhado anexado à callbackUrl
# (?key=...) para o nosso webhook conseguir confirmar que um POST "pago"
# realmente veio da EMIS. Sem isto, qualquer pessoa que soubesse o orderId
# de UM pedido seu podia fingir que o pagamento foi aprovado sem pagar.
# Gerar com: openssl rand -hex 32
EMIS_WEBHOOK_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
